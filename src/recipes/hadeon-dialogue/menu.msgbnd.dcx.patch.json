[
  {
    "file": "TalkMsg.fmg",
    "id": 999801100,
    "beforeMissing": true,
    "before": null,
    "after": "Thou shalt find me as before."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801110,
    "beforeMissing": true,
    "before": null,
    "after": "Unyielding."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801120,
    "beforeMissing": true,
    "before": null,
    "after": "Forsake these fruitless ambitions."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801200,
    "beforeMissing": true,
    "before": null,
    "after": "Doth his promise grow sweeter with each defeat?"
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801300,
    "beforeMissing": true,
    "before": null,
    "after": "Each defeat hath taught thee naught."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801310,
    "beforeMissing": true,
    "before": null,
    "after": "Let this be thy last."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801400,
    "beforeMissing": true,
    "before": null,
    "after": "Again thou comest, bearing another’s hunger."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801410,
    "beforeMissing": true,
    "before": null,
    "after": "Then meet thy familiar end."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801500,
    "beforeMissing": true,
    "before": null,
    "after": "Ngh... Even bound..."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801510,
    "beforeMissing": true,
    "before": null,
    "after": "thy reach grows long, Nemesis."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801520,
    "beforeMissing": true,
    "before": null,
    "after": "Have these lands not bled enough for thee?"
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801600,
    "beforeMissing": true,
    "before": null,
    "after": "Ngh... His chains hold."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801610,
    "beforeMissing": true,
    "before": null,
    "after": "Yet still his hunger grows."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801700,
    "beforeMissing": true,
    "before": null,
    "after": "Ngh... That strength..."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801710,
    "beforeMissing": true,
    "before": null,
    "after": "what hast thou surrendered?"
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801800,
    "beforeMissing": true,
    "before": null,
    "after": "Ngh... I shall give him no dominion here."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999801900,
    "beforeMissing": true,
    "before": null,
    "after": "An oath such as mine yieldeth not."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802000,
    "beforeMissing": true,
    "before": null,
    "after": "Rise a thousand times."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802010,
    "beforeMissing": true,
    "before": null,
    "after": "I shall not yield."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802100,
    "beforeMissing": true,
    "before": null,
    "after": "Find thee a worthier servant."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802200,
    "beforeMissing": true,
    "before": null,
    "after": "Was this thy chosen?"
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802300,
    "beforeMissing": true,
    "before": null,
    "after": "Another falls. Thy prison stands."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802400,
    "beforeMissing": true,
    "before": null,
    "after": "Fool… wouldst thou doom these lands?"
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802410,
    "beforeMissing": true,
    "before": null,
    "after": "Refuse the Bindseal…"
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802420,
    "beforeMissing": true,
    "before": null,
    "after": "disturb not the crystal..."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802500,
    "beforeMissing": true,
    "before": null,
    "after": "Thy strength… awakens an old remembrance."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802510,
    "beforeMissing": true,
    "before": null,
    "after": "Another stood where thou standest."
  },
  {
    "file": "TalkMsg.fmg",
    "id": 999802520,
    "beforeMissing": true,
    "before": null,
    "after": "Him… I called lord."
  }
]
